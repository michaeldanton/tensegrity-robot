#include <Arduino.h>

const float wheelDiameter = 0.2;
const float circumference = wheelDiameter * PI;
float distance = 0;

void setup() {
  Serial.begin(9600);
}

void loop() {
  if (Serial.available() > 0) {
    distance = Serial.parseFloat();

    if (distance > 0) {
      float rotations = distance / circumference;
      Serial.println(rotations);
    }
  }
}
